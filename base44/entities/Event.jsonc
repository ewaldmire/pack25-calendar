{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Event Name",
      "description": "The name of the event"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date",
      "description": "For multi-day events; leave blank for single-day"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "dens": {
      "type": "array",
      "title": "Dens",
      "items": {
        "type": "string",
        "enum": [
          "lions",
          "tigers",
          "wolves",
          "bears",
          "webelos",
          "aols",
          "leaders"
        ]
      }
    }
  },
  "required": [
    "name",
    "date"
  ]
}
