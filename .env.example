# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Random secret used to sign leader session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# bcrypt hash of the shared leader password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" 'your-password'
LEADER_PASSWORD_HASH=

# IANA timezone used for timed events in the calendar.ics feed
PACK_TIMEZONE=America/Chicago

# Port the server listens on
PORT=3000

NODE_ENV=production
